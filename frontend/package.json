{
  "name": "blackiron-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "changelog": "node scripts/gen-changelog.mjs",
    "predev": "node scripts/gen-changelog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-changelog.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "android": "npm run build && cap sync android",
    "android:icons": "node scripts/gen-app-icons.mjs && capacitor-assets generate --android --iconBackgroundColor \"#12100c\" --iconBackgroundColorDark \"#12100c\" --splashBackgroundColor \"#12100c\" --splashBackgroundColorDark \"#12100c\"",
    "check": "node scripts/check-imports.cjs && node scripts/check-lists.cjs && node scripts/check-data.cjs && node scripts/check-offline.cjs && node scripts/check-note.cjs && node scripts/check-screens.cjs && node scripts/check-odd.cjs && node scripts/check-heat.cjs && node scripts/check-goal.cjs && node scripts/check-take.cjs && node scripts/check-nav.cjs && node scripts/check-stale.cjs && node scripts/check-lock.cjs && node scripts/check-reach.cjs && node scripts/check-rest.cjs",
    "screens": "node scripts/check-screens.cjs",
    "odd": "node scripts/check-odd.cjs",
    "imports": "node scripts/check-imports.cjs",
    "lists": "node scripts/check-lists.cjs",
    "offline": "node scripts/check-offline.cjs",
    "note": "node scripts/check-note.cjs",
    "heat": "node scripts/check-heat.cjs",
    "take": "node scripts/check-take.cjs",
    "goal": "node scripts/check-goal.cjs",
    "nav": "node scripts/check-nav.cjs",
    "stale": "node scripts/check-stale.cjs",
    "reach": "node scripts/check-reach.cjs && node scripts/check-rest.cjs",
    "lock": "node scripts/check-lock.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "axios": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "vite": "^5.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "typescript": "^7.0.2"
  }
}
