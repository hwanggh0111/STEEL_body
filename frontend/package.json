{
  "name": "blackiron-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "changelog": "node scripts/gen-changelog.mjs",
    "feed": "node scripts/gen-feed.mjs",
    "predev": "node scripts/gen-changelog.mjs && node scripts/gen-parts.mjs && node scripts/gen-feed.mjs && node scripts/gen-wall.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-changelog.mjs && node scripts/gen-parts.mjs && node scripts/gen-feed.mjs && node scripts/gen-wall.mjs",
    "build": "vite build && node scripts/route-chunks.mjs && node scripts/precompress.mjs",
    "preview": "vite preview",
    "shell": "node scripts/gen-shell.mjs",
    "android": "npm run build && npm run shell && cap sync android",
    "aab": "npm run build && npm run shell && cap sync android && node scripts/build-android.mjs",
    "apk": "npm run build && npm run shell && cap sync android && node scripts/build-android.mjs apk",
    "trim": "node scripts/trim-android-res.mjs",
    "android:icons": "node scripts/gen-app-icons.mjs && capacitor-assets generate --android --iconBackgroundColor \"#12100c\" --iconBackgroundColorDark \"#12100c\" --splashBackgroundColor \"#12100c\" --splashBackgroundColorDark \"#12100c\" && npm run trim",
    "play:assets": "node scripts/gen-play-assets.mjs",
    "check": "node ../scripts/run-checks.cjs",
    "plate": "node scripts/check-plate.cjs",
    "font": "node scripts/check-font.cjs",
    "settings": "node scripts/check-settings.cjs",
    "routineform": "node scripts/check-routineform.cjs",
    "hwsave": "node scripts/check-hwsave.cjs",
    "loadfail": "node scripts/check-loadfail.cjs",
    "scroll": "node scripts/check-scroll.cjs",
    "signup": "node scripts/check-signup.cjs",
    "checkfeed": "node scripts/check-feed.cjs",
    "screens": "node scripts/check-screens.cjs",
    "odd": "node scripts/check-odd.cjs",
    "imports": "node scripts/check-imports.cjs",
    "lists": "node scripts/check-lists.cjs",
    "offline": "node scripts/check-offline.cjs",
    "note": "node scripts/check-note.cjs",
    "heat": "node scripts/check-heat.cjs",
    "take": "node scripts/check-take.cjs",
    "blank": "node scripts/check-blank.cjs",
    "stuck": "node scripts/check-stuck.cjs",
    "cap": "node scripts/check-cap.cjs",
    "dead": "node scripts/check-dead.cjs",
    "name": "node scripts/check-name.cjs",
    "goal": "node scripts/check-goal.cjs",
    "nav": "node scripts/check-nav.cjs",
    "stale": "node scripts/check-stale.cjs",
    "reach": "node scripts/check-reach.cjs && node scripts/check-rest.cjs",
    "lock": "node scripts/check-lock.cjs",
    "shape": "node scripts/check-shape.cjs",
    "homeparts": "node scripts/check-homeparts.cjs",
    "breath": "node scripts/check-breath.cjs",
    "recover": "node scripts/check-recover.cjs",
    "hwresume": "node scripts/check-hwresume.cjs",
    "secview": "node scripts/check-secview.cjs",
    "isoday": "node scripts/check-isoday.cjs",
    "keys": "node scripts/check-keys.cjs",
    "gone": "node scripts/check-gone.cjs",
    "cut": "node scripts/check-cut.cjs",
    "reps": "node scripts/check-reps.cjs",
    "sore": "node scripts/check-sore.cjs",
    "tone": "node scripts/check-tone.cjs",
    "weight": "node scripts/check-weight.cjs",
    "score": "node scripts/check-score.cjs",
    "reset": "node scripts/check-reset.cjs",
    "nextset": "node scripts/check-nextset.cjs",
    "savedid": "node scripts/check-savedid.cjs",
    "logtypes": "node scripts/check-logtypes.cjs",
    "role": "node scripts/check-role.cjs",
    "parts": "node scripts/gen-parts.mjs && node scripts/check-parts.cjs",
    "precompress": "node scripts/precompress.mjs",
    "share": "node scripts/check-share.cjs",
    "step": "node scripts/check-step.cjs",
    "phone": "node scripts/phone-dev.mjs",
    "tap": "node scripts/check-tap.cjs",
    "sw": "node scripts/check-sw.cjs",
    "privacy": "node scripts/check-privacy.cjs",
    "alarm": "node scripts/check-alarm.cjs",
    "widget": "node scripts/check-widget.cjs",
    "health": "node scripts/check-health.cjs",
    "maint": "node scripts/check-maint.cjs",
    "block": "node scripts/check-block.cjs",
    "setplan": "node scripts/check-setplan.cjs",
    "serif": "node scripts/gen-serif.mjs",
    "wall": "node scripts/gen-wall.mjs",
    "rest": "node scripts/check-rest.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "axios": "1.13.6",
    "capacitor-health": "^8.4.0",
    "esbuild": "^0.21.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "vite": "^5.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "typescript": "^7.0.2"
  }
}
