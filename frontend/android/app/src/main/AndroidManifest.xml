<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 백업을 끈다. 켜두면 개인 운동기록 · WebView 에 담긴 로그인 정보가
         adb 백업이나 클라우드 백업으로 빠져나갈 수 있다. 진짜 데이터는 서버에 있으니
         기기 백업으로 되살릴 필요도 없다 (allowBackup=false 하나로 둘 다 막힌다) -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 겹쳐 찍기 (2026-09-16). 웹뷰가 getUserMedia 로 카메라를 연다 —
         이 줄이 없으면 앱에서만 「카메라를 열지 못했어요」가 뜨고 브라우저에서는 멀쩡하다.
         **사진을 저장하거나 읽지 않는다** — 찍은 것은 곧바로 서버로 가므로
         저장소 권한은 안 받는다 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
