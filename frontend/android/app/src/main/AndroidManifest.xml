<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 백업을 끈다. 켜두면 개인 운동기록 · WebView 에 담긴 로그인 정보가
         adb 백업이나 클라우드 백업으로 빠져나갈 수 있다. 진짜 데이터는 서버에 있으니
         기기 백업으로 되살릴 필요도 없다 (allowBackup=false 하나로 둘 다 막힌다) -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 위젯 (2026-10-16).
             **exported 는 true 여야 한다** — 위젯을 그려 주는 것은 런처(홈 화면 앱)라
             다른 앱이다. false 면 위젯 목록에 아예 안 뜬다.
             글은 앱이 넘긴 것을 읽기만 한다 (TodayWidget 머리글) -->
        <receiver
            android:name=".TodayWidget"
            android:label="@string/widget_today_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- ══ 건강 앱(헬스 커넥트) 연동 — 2026-10-16 ═══════════════════════════
             **첫 출시에서 빼려면 이 블록과 아래 「건강 권한」 블록을 지우고
             `npm uninstall capacitor-health && npx cap sync android` 하면 된다.**
             화면 쪽은 저절로 꺼진다(`src/data/healthLink.js` 가 플러그인을 못 찾으면
             단추를 아예 안 그린다). 까닭은 docs/PLAY-STORE.md 의 「건강연동」 칸.

             이 자리는 **헬스 커넥트가 「왜 이 권한이 필요한가」를 물을 때** 여는 화면이다.
             안드로이드 13까지는 activity, 14부터는 activity-alias 로 찾는다 —
             **둘 다 있어야 한다.** 없으면 권한 화면에서 개인정보처리방침 줄이 깨진다 -->
        <activity
            android:name="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- ══ 건강 앱 연동 끝 ═══════════════════════════════════════════════ -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 겹쳐 찍기 (2026-09-16). 웹뷰가 getUserMedia 로 카메라를 연다 —
         이 줄이 없으면 앱에서만 「카메라를 열지 못했어요」가 뜨고 브라우저에서는 멀쩡하다.
         **사진을 저장하거나 읽지 않는다** — 찍은 것은 곧바로 서버로 가므로
         저장소 권한은 안 받는다 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ══ 건강 권한 — 2026-10-16 ════════════════════════════════════════════
         **쓰는 둘만 남긴다.** `capacitor-health` 플러그인은 제 매니페스트에 열세 개를
         다 적어두고 있고, 그것이 **그대로 합쳐진다**(라이브러리 매니페스트 병합).
         적어둔 권한은 **동의 화면에 전부 뜬다** — 쓰지도 않을 걸음수 · 심박 · 식사를
         같이 물으면 사람은 그 자리에서 거절한다. 그래서 나머지 열하나를 지운다.

         남기는 둘 —
           READ_WEIGHT     체중 (kg)
           READ_BODY_FAT   체지방률 (%)
         **골격근량은 안 받는다**: 헬스 커넥트에 있는 것은 제지방량이고 그건 다른 값이다
         (`src/data/healthLink.js` 머리글).

         `<queries>` 는 「이 폰에 헬스 커넥트가 깔려 있나」를 물어보기 위한 것이다 —
         안드로이드 11부터 다른 앱이 있는지 보려면 여기 적어야 한다. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <!-- ══ 건강 권한 끝 ═══════════════════════════════════════════════════ -->
</manifest>
