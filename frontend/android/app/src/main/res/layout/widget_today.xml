<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 한 장. **앱의 카드와 같은 색**이다 (#12100c 바닥 · #c8a04a 금색).
     글꼴은 못 싣는다 — 위젯은 RemoteViews 라 앱의 글꼴(Bebas Neue)을 못 쓴다.
     그래서 **크기와 색으로** 같은 결을 낸다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#c8a04a"
        android:textSize="21sp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="가슴" />

    <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#efe9df"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="3일째 식어 있습니다" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="#8b8171"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="등 오늘 · 하체 2일 전" />
</LinearLayout>
