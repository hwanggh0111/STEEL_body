<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 의 백업/기기이전 규칙. 아무것도 내보내지 않는다 —
     개인 운동기록과 로그인 정보를 클라우드 백업·기기 이전으로 빼내지 못하게.
     allowBackup=false 와 같은 뜻을 새 API 에도 맞춘다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
