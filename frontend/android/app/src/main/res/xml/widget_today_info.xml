<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯의 크기와 갱신 주기 (2026-10-16).
     minWidth/Height 는 **셀 수가 아니라 dp** 다 — 2×1 칸은 110×40dp 로 잡는다
     (칸 하나가 70dp + 사이 30dp). 세로로 늘려 쓸 수 있게 resizeMode 를 둔다.
     updatePeriodMillis 의 30분(1800000)은 **안드로이드의 최솟값**이다. 평소에는
     앱이 글을 넘길 때 다시 그리고(TodayWidget.refresh), 이것은 앱을 한참 안 열었을
     때의 바닥이다 — 더 잦게 적어도 OS 가 안 들어준다 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_today_desc" />
