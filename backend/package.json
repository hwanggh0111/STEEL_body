{
  "name": "blackiron-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node --max-old-space-size=256 --optimize-for-size src/index.js",
    "dev": "nodemon src/index.js",
    "check": "node scripts/check-join.cjs && node scripts/check-id.cjs && node scripts/check-logfile.cjs && node scripts/check-oauth.cjs && node scripts/check-reminder.cjs && node scripts/check-account.cjs && node scripts/check-routines.cjs && node scripts/check-security.cjs && node scripts/check-proxy.cjs && node scripts/check-web.cjs && node scripts/check-photos.cjs && node scripts/check-cache.cjs && node scripts/check-cold.cjs && node scripts/check-day.cjs && node scripts/check-import.cjs && node scripts/check-save.cjs && node scripts/check-api.cjs && node scripts/check-abuse.cjs && node scripts/check-sync.cjs && node scripts/check-storage.cjs && node scripts/check-owner.cjs && node scripts/check-sweep.cjs && node scripts/check-warm.cjs",
    "storage": "node scripts/check-storage.cjs",
    "owner": "node scripts/check-owner.cjs",
    "backup": "node scripts/backup.cjs",
    "smoke": "node scripts/smoke.cjs",
    "sync": "node scripts/check-sync.cjs",
    "seed": "node scripts/seed.cjs",
    "seed:clear": "node scripts/seed.cjs --clear",
    "smoke:clean": "node scripts/smoke.cjs --clean-all",
    "web": "node scripts/check-web.cjs",
    "proxy": "node scripts/check-proxy.cjs",
    "shield": "node scripts/check-shield.cjs",
    "photos": "node scripts/check-photos.cjs",
    "cache": "node scripts/check-cache.cjs",
    "cold": "node scripts/check-cold.cjs",
    "day": "node scripts/check-day.cjs",
    "import": "node scripts/check-import.cjs",
    "save": "node scripts/check-save.cjs && node scripts/check-api.cjs && node scripts/check-abuse.cjs",
    "bench": "node scripts/bench.cjs",
    "boot": "node scripts/boot.cjs",
    "probe": "node scripts/probe.cjs",
    "oauth": "node scripts/check-oauth.cjs",
    "join": "node scripts/check-join.cjs",
    "id": "node scripts/check-id.cjs",
    "logfile": "node scripts/check-logfile.cjs",
    "odd": "node scripts/check-odd-api.cjs",
    "sweep": "node scripts/check-sweep.cjs && node scripts/check-warm.cjs",
    "abuse": "node scripts/check-abuse.cjs",
    "account": "node scripts/check-account.cjs",
    "api": "node scripts/check-api.cjs",
    "reminder": "node scripts/check-reminder.cjs",
    "routines": "node scripts/check-routines.cjs",
    "security": "node scripts/check-security.cjs",
    "warm": "node scripts/check-warm.cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
