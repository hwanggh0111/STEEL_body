# 기록을 어디에 둘까.
#
# 비워두면 **파일**(blackiron.json · photos.json). 내 컴퓨터에서는 이게 맞다.
# 배포할 때는 **Postgres 연결 주소**를 넣는다 — Render 무료 판은 디스크를 못 붙여서
# 파일로 두면 재시작마다 기록이 사라진다. 처음 한 번은 쓰던 파일을 그대로 옮겨 올린다.
#   예) postgresql://사용자:암호@호스트/디비?sslmode=require
DATABASE_URL=

PORT=4000
NODE_ENV=development
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_STRING_MIN_64_CHARS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
ADMIN_EMAIL=admin@example.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 네이버 — developers.naver.com > 애플리케이션 등록.
# 「제공 정보 선택」에서 **이메일 주소**를 필수로 둔다. 안 두면 메일을 안 주고,
# 그러면 「메일 주소 알려주기」 걸음으로 떨어진다(되기는 된다).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 인스타그램 — developers.facebook.com > 앱 > Instagram > API 설정.
# **메일을 주지 않는다** — 들어온 뒤 앱이 메일을 한 번 묻는다(/oauth/email).
# ⚠ 스코프가 instagram_business_basic 뿐이라 **비즈니스·크리에이터 계정만** 들어온다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 트위터(X) — developer.x.com > Projects & Apps > User authentication settings.
# Type 은 **Web App**, 권한은 **Read** 로 충분하다. PKCE 는 앱이 알아서 한다.
# SECRET 은 Confidential client 일 때만 적는다 — Public client 면 비워둔다
# (섞으면 invalid_client 로 떨어진다).
# **메일을 주지 않는다** (다름 승인을 받으면 준다). 그때까지는 앱이 메일을 묻는다.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# SMTP (가입 인증 / 비밀번호 재설정 — 인증번호 발송)
# 미설정 시: 개발 모드는 응답 body로 인증번호 노출, 프로덕션은 발송 실패
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STEEL BODY <noreply@steelbody.app>

# 웹 푸시 VAPID (운동 알림)
# 발급받을 데가 없다 — 직접 만든다: npx web-push generate-vapid-keys
# 한 번 만들면 바꾸지 않는다 (바꾸면 이미 켜둔 사람의 구독이 전부 죽는다)
# 없으면: 알림만 안 나간다 (앱은 그대로 돈다). 설정함에 「서버가 아직 못 보내요」로 뜬다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 인증번호를 응답에 실어 보낸다 — **내 컴퓨터에서만.**
# `npm run smoke` · `seed` · `probe` 가 가입을 하려면 번호를 받아야 한다(10/2 에 가입에
# 인증번호가 붙었다). SMTP 열쇠가 없으면 이것 없이도 실려 오지만, 열쇠를 넣은 뒤에는
# 메일로만 가서 스크립트가 멈춘다.
# **배포(Render)에는 넣지 않는다.** NODE_ENV=production 이면 값이 있어도 무시한다.
DEV_ECHO_CODE=1
