# Dependencies
node_modules/

# Environment
.env
*.env.local

# Build output
frontend/dist/

# 안드로이드 서명 열쇠 — 새면 남이 우리 이름으로 앱을 올릴 수 있다. 잃어버리면 업데이트를 못 올린다
*.jks
*.keystore
frontend/android/keystore.properties

# Database
backend/blackiron.json
backend/photos.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# 밀어둔 보안 로그 한 벌 (*.log 는 이것을 안 막는다)
*.log.1

# 검사가 쓰는 임시 DB (DB_FILE)
backend/.check-*.json

# 시안 작업 파일 (캔버스 · 만들 때 쓴 스크립트). 한 장에 편집기가 통째로 들어 있어 19MB 다.
# 시안은 claude.ai 링크로 따로 남아 있고, 링크는 README 개발 일지에 적는다
.design/

# VS Code 작업 공간 — 사람마다 다르다
hgh.code-workspace

# 재는 자리가 쓰는 임시 DB (npm run bench). 끝나면 지우지만 중간에 멎으면 남는다
backend/scripts/.bench*.json
backend/scripts/.probe*.json
backend/scripts/.bench-*.cjs

# 통째로 떠둔 백업 (npm run backup). **사람들의 기록 전부가 들어 있다** —
# 본체가 gitignore 인 것과 같은 까닭으로 여기도 절대 올리지 않는다
backend/backups/

# APK 에 실을 껍데기 (npm run shell 이 public/app-offline.html 에서 만든다)
frontend/shell/
